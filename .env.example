# Server-managed API keys (do NOT expose in UI).
# The env-var names below are kept for backward compatibility — they
# accept any OpenAI-compatible LLM provider. Point the base URL at
# your provider's /v1 endpoint.
DASHSCOPE_API_KEY=your_provider_api_key
DASHSCOPE_API_BASE=https://your-provider.example.com/v1

# PubMed E-utilities key (optional; raises rate limits if set).
PUBMED_API_KEY=

# Local-first vector store.
VECTOR_BACKEND=lancedb
LANCEDB_PATH=./data/lancedb/bge-small-en-v1.5
LANCEDB_TABLE=protocols

# Embedding backend/model used for both ingestion and query-time retrieval.
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Rerank backend:
# - none: skip rerank; fall back to LanceDB hybrid + keyword scoring
# - dashscope: use DashScopeRerank with RERANK_MODEL
# - local: use sentence-transformers CrossEncoder with LOCAL_RERANK_MODEL
RERANK_BACKEND=local
RERANK_MODEL=none
LOCAL_RERANK_MODEL=BAAI/bge-reranker-base

# Optional Milvus / Zilliz fallback (only if VECTOR_BACKEND=milvus).
MILVUS_URI=
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_TOKEN=
MILVUS_COLLECTION=
