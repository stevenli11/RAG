# Server-managed API keys (do NOT expose in UI).
# The env-var names below are kept for backward compatibility — they
# accept any OpenAI-compatible LLM provider. Point the base URL at
# your provider's /v1 endpoint.
DASHSCOPE_API_KEY=your_provider_api_key
DASHSCOPE_API_BASE=https://your-provider.example.com/v1

# PubMed E-utilities key (optional; raises rate limits if set).
PUBMED_API_KEY=

# Local-first vector store.
VECTOR_BACKEND=lancedb
LANCEDB_PATH=./data/lancedb
LANCEDB_TABLE=protocols

# Cross-encoder rerank model name (provider-specific).
RERANK_MODEL=your_rerank_model_name

# Optional Milvus / Zilliz fallback (only if VECTOR_BACKEND=milvus).
MILVUS_URI=
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_TOKEN=
MILVUS_COLLECTION=
